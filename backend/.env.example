# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://soc_user:soc_password@localhost:5432/soc_platform
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@techd.com
SMTP_PASS=your-smtp-password
SMTP_FROM=SOC Platform <notifications@techd.com>

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key-change-in-production

# File Upload
MAX_FILE_SIZE=26214400
UPLOAD_DIR=./uploads
